# ==============================================================================
#   PUPSJ HUB - Global Environment Configuration (Template)
# ==============================================================================
# Copy this file to .env and fill in your actual values.

# ── DATABASE (PostgreSQL) ─────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pupsj_hub
DB_USER=postgres
DB_PASSWORD=1234567

# ── NODE SERVER ───────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# ── AUTHENTICATION ────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_random_string_abc123
JWT_EXPIRES_IN=7d
SESSION_SECRET=change_this_to_another_random_string

# ── EMAIL DELIVERY (Nodemailer) ───────────────────────────────────────────────
# In development, if user/pass are empty, emails are logged to the console.
# In production, EMAIL_USER and EMAIL_PASS must be set or email delivery will fail.
# For Gmail, use an App Password, not your regular Gmail password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=pupsjhub@gmail.com
EMAIL_PASS=Pupsjhub1!
EMAIL_FROM=PUPSJ HUB <noreply@pupsj.edu.ph>

# ── AI SIDECAR (Python) ───────────────────────────────────────────────────────
AI_SIDECAR_URL=http://localhost:8001

# ── AI MODELS (LLMs) ──────────────────────────────────────────────────────────
# GROQ
GROQ_API_KEY=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
GROQ_MODEL=llama-3.3-70b-versatile

# GEMINI (Primary)
GEMINI_API_KEY=AIzaSyBBp4f3psmQSfU6cGPfafmE_IxlEwGug28
GEMINI_MODEL=gemini-2.5-flash

# OLLAMA (Fallback)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# ── ML MODELS ─────────────────────────────────────────────────────────────────
LF_VISION_MODEL=clip-ViT-B-32

# ── PRODUCTION HARDENING (Optional) ───────────────────────────────────────────
ALLOWED_ORIGINS=
BLOCKED_IPS=
