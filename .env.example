# ==============================================================================
#   PUPSJ HUB - Global Environment Configuration (Template)
# ==============================================================================
# Copy this file to .env and fill in your actual values.
# Do NOT commit .env with real credentials to version control.

# ── DATABASE (MySQL 8.0+) ─────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pupsj_hub
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# ── NODE SERVER ───────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# ── AUTHENTICATION ────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_secure_random_string_min_32_chars
JWT_EXPIRES_IN=7d
SESSION_SECRET=replace_with_another_secure_random_string

# ── EMAIL DELIVERY (Nodemailer) ───────────────────────────────────────────────
# In development, if user/pass are empty, emails are logged to the console.
# In production, EMAIL_USER and EMAIL_PASS must be set or email delivery will fail.
# For Gmail, use an App Password, not your regular Gmail password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@domain.edu.ph
EMAIL_PASS=your_email_app_password
EMAIL_FROM="PUPSJ HUB <noreply@pupsj.edu.ph>"

# ── AI SIDECAR (Python Microservice) ──────────────────────────────────────────
AI_SIDECAR_URL=http://localhost:8001

# ── AI MODELS & API KEYS ──────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# ── ML MODELS ─────────────────────────────────────────────────────────────────
LF_VISION_MODEL=clip-ViT-B-32

# ── SECURITY & FIREWALL (Optional) ────────────────────────────────────────────
ALLOWED_ORIGINS=
BLOCKED_IPS=
ALLOWED_IPS=
